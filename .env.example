# =============================================================================
# STORE RATING MANAGEMENT SYSTEM - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env inside the backend/ folder and adjust values
# =============================================================================

# Server Port
PORT=5000

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=store_rating_db

# JSON Web Token Secret & Expiry
JWT_SECRET=super_secret_jwt_store_rating_key_2026_change_me
JWT_EXPIRES_IN=7d
